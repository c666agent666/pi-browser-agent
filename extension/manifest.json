{
  "name": "Pi Browser Agent",
  "version": "0.1.0",
  "manifest_version": 3,
  "description": "Side panel for Pi coding agent with browser integration, screenshots, and vision",
  "icons": {
    "16": "public/icon.svg",
    "48": "public/icon.svg",
    "128": "public/icon.svg"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "http://127.0.0.1:3848/*",
    "http://localhost:3848/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http://127.0.0.1:3848 ws://127.0.0.1:3848"
  }
}